#!/usr/bin/env python3
import argparse
import os
import sys
import math
import bisect
import typing as t

parser  = argparse.ArgumentParser(
    description="Calculate expected perf vs GA for tp4cp2pp8",
    formatter_class=argparse.ArgumentDefaultsHelpFormatter
)
parser.add_argument(
    "--no-header", action="store_true",
    help="Suppress header line"
)
parser.add_argument(
    "-n", "--gpus", type=int, default=1024,
    help="number of gpus"
)
#parser.add_argument(
#    "--plot", metavar="PNG",
#    help="Write a bar chart of totals to this PNG file")
parser.add_argument(
    "--summary", action="store_true",
    help="don't output convergence details"
)
parser.add_argument(
    "--val-divider", type=float, default=2.5,
    help="eval_it_time is train_it_time/val_divider"
)
parser.add_argument(
    "--train-it-overhead", type=float,
#    default=0.676,
    default=0.171,
    help="train_it_time=ga*train_it_per_samp + train_it_overhead"
)
parser.add_argument(
    "--train-it-per-sample", type=float,
#    default=0.161,
    default=0.176,
    help="train_it_time=ga*train_it_per_samp + train_it_overhead"
)
parser.add_argument(
    "--max-ga", type=int, default=160,
    help="how far out to look at ga"
)
args = parser.parse_args()
prog_name = os.path.basename(sys.argv[0])  # Extracts script name

if (args.gpus % 64 != 0):
    parser.error(f"{prog_name}: tp4cp2pp8 requires gpus be a multiple of 64")

def training_iteration_time(ga):
    return args.train_it_per_sample*ga + args.train_it_overhead

def validation_iteration_time(ga):
    return training_iteration_time(ga)/args.val_divider

def iterations_per_eval(gbs):
    return math.ceil(5760/gbs)

def likely_convergence_samples(gbs):
    # remeasured with small gbs (256, 576,768) on Aug 27 for closer match:
    # return math.ceil(263677 + (28.7*gbs) + (0.00388*gbs*gbs))
    return math.ceil(275655 + (17.7*gbs) + (0.00572*gbs*gbs))

def round_up_by(x,gbs):
    return gbs*math.ceil(x/gbs)

def first_eval(gbs):
    return round_up_by(18432*math.ceil(0.0026*gbs + 10), gbs)

def eval_freq(gbs):
    return round_up_by(18432, gbs)

def likely_score_samples(gbs):
    feval_gbs=first_eval(gbs)
    return feval_gbs+round_up_by(likely_convergence_samples(gbs)-feval_gbs, eval_freq(gbs))

def likely_training_iterations(gbs):
    return likely_score_samples(gbs)/gbs
    
def likely_evals(gbs):
    return ((likely_convergence_samples(gbs)-first_eval(gbs))/eval_freq(gbs))+1

# rcp 576 won't be avail this round
#rcp_means=[(576,294912.0),(1152,313344.0),(2304,368640.0),(4608,493056.0)]
rcp_means=[(1152,313344.0),(2304,368640.0),(4608,493056.0)]

def interp(x: float, pairs: t.List[t.Tuple[float, float]]) -> float:
    if not pairs:
        raise ValueError("empty pairs")

    # clamp smallest RCP
    if x <= pairs[0][0]:
        return pairs[0][1]

    i = bisect.bisect_left(pairs, (x, -math.inf))

    # larger gbs than largest RCP is illegal
    if i >= len(pairs):
        return math.inf

    x1, y1 = pairs[i-1]
    x2, y2 = pairs[i]

    return y1 + (((x-x1)*(y2-y1)) / (x2-x1))

def find_min_time(gpus):
    columns=["ga", "gbs", "scaled_time", "time", "val_time", "eval_overhead"]
    if (not args.summary):
        columns+=["xput","samples", "slack", "rcp", "rcp_scaling"]
    print(*columns, sep="\t")
    mintime = 999999
    minga = 99999
    for ga in range(8, args.max_ga+1, 8):
        star=""
        gbs = (gpus/64) * ga
        train_it_time = training_iteration_time(ga)
        val_it_time = validation_iteration_time(ga)
        train_its = likely_training_iterations(gbs)
        val_its = likely_evals(gbs)*iterations_per_eval(gbs)
        train_time = train_its * train_it_time
        val_time = val_its * val_it_time
        total_time = train_time + val_time
        likely_samples = train_its*gbs
        rcp_mean = interp(gbs, rcp_means)
        if math.isfinite(rcp_mean):
            rcp_scaling = rcp_mean/min(likely_samples, rcp_mean)
        else:
            rcp_scaling = 1.0
            star="!"

        scaled_time = total_time * rcp_scaling
        if (scaled_time < mintime):
            star="*"
            mintime = scaled_time
            minga = ga
        columns=[ f"{ga}{star}", int(gbs), round(scaled_time), round(total_time), round(val_time),
                  f"{(100.0*val_time/total_time):.1f}%"
                 ]
        if (not args.summary):
            likely_samples=train_its*gbs
            slack=(likely_samples-likely_convergence_samples(gbs))/eval_freq(gbs)
            columns+=[ f"{(gbs/train_it_time):.2f}",
                       int(likely_samples),
                       f"{slack:>3.0%}",
                       f"{interp(gbs, rcp_means):.1f}",
                       f"{(rcp_scaling-1.0):.1%}"
                      ]
        print(*columns, sep="\t")

    return (mintime, minga)

(mintime, minga) = find_min_time(args.gpus)
if (args.summary):
    print(f"optimal ga is {minga}, (gbs {minga*args.gpus/64}), giving predicted runtime of {mintime}")
#gpus=32
#while (gpus < 8000):
#    gpus=gpus*2
#    (mintime, minga)=find_min_time(gpus)
#    print(gpus, minga, minga*gpus/64, mintime)
    
exit(0)

