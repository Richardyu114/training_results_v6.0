#!/bin/bash
set -euo pipefail

exec </dev/null >/dev/null 2>&1

pidfile=".running_pid"
logfile="rack-node-tracker.log"
echo $$ > "$pidfile"

datafile="rack-node-database.txt"

while true; do
    # Check if still the active job
    if [[ ! -f "$pidfile" || "$(cat "$pidfile")" != "$$" ]]; then
        echo "$$: [$(date)] Another instance is running or pidfile removed. Exiting." >> "$logfile"
        exit 0
    fi

    timestamp="$(date +%y%m%d-%H%M%S)"
    backup="${datafile}+${timestamp}"
    tmpfile="$(mktemp)"
    chmod 644 "$tmpfile"

    sort -u <(racks-and-nodes) "$datafile" > "$tmpfile"

    if ! cmp -s "$tmpfile" "$datafile"; then
        echo "$$: [$(date)] Changes detected. Backing up and updating $datafile" >> "$logfile"
        cp "$datafile" "$backup"
        mv "$tmpfile" "$datafile"
    else
        echo "$$: [$(date)] No changes. Skipping update." >> "$logfile"
        rm -f "$tmpfile"
    fi

    sleep 300
done
