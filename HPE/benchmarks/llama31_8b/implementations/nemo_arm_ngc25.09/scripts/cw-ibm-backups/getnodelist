#!/bin/bash

reservation_name=""

if [[ "${1:-}" ]]; then
   reservation_name="$1"
fi

DEFAULT_PARTITION=$(scontrol show part -o | grep Default=YES | sed -E -e 's/^.*PartitionName=([^[:blank:]]*) .*$/\1/')

sinfo "-p${DEFAULT_PARTITION}" --Node --noheader --format='%N|%t|%i' | tr '|' '\t' | grep -Ev '(drain)|(down)|(inval)|(maint)' | awk '$3=="'"${reservation_name}"'"' | cut -f1
