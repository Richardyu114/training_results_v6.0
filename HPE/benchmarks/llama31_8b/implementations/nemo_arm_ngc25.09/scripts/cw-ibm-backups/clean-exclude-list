#!/bin/bash

THIS_SCRIPT_DIR="$(dirname "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"

if [[ "$#" -ne 1 ]]; then
    echo "Usage: $0 exclude-list" >&2
    exit 1
fi

if [[ ! -f "$1" ]]; then
    echo "Can not find file $1" >&2
    exit 1
fi

comm -12 \
     <("${THIS_SCRIPT_DIR}/getnodelist" | sort) \
     <(sort $1) | sort
