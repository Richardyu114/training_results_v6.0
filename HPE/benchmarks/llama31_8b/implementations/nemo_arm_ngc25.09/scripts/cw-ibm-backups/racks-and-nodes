#!/bin/bash

scontrol show node --json | jq '
  .nodes
  | map(. + { DH: (.features | map(select(startswith("DH"))) | .[0]) })
  | group_by(.DH)
  | map({
      NVLINKDomain: .[0].DH,
      nodes: map({ name, comment })
    })
' | python3 -c "
import json, sys
data = json.load(sys.stdin)
for group in data:
    domain = group['NVLINKDomain'].replace('-', '_')
    for node in group['nodes']:
        print(f\"{domain}\t{node['name']}\t{node['comment']}\")
"
