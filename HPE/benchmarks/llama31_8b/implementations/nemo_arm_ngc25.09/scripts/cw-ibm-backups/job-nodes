#!/bin/bash

THIS_SCRIPT_DIR="$(dirname "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"

if [[ "$#" -lt 1 ]]; then
    echo "Usage: $0 jobnum1 [jobnum2 ...]" >& 2
    exit 1
fi

for jobnum in "$@"; do
    sacct --noheader --allocations --job "${jobnum}" --format=nodelist -P | xargs scontrol show hostname
done | sort --unique
