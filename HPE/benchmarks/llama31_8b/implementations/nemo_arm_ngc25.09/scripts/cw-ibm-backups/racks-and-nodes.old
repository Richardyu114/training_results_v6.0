#!/bin/bash

scontrol show node --json | jq '
  .nodes
  | map(. + { DH: (.features | map(select(startswith("DH"))) | .[0]) })
  | group_by(.DH)
  | map({
      NVLINKDomain: .[0].DH,
      nodeNames: map(.name)
    })
' | python3 -c 'import json
import sys

data = json.load(sys.stdin)

for group in data:
    domain = group["NVLINKDomain"].replace("-", "_")
    for node in group["nodeNames"]:
        print(f"{domain}\t{node}")
'
