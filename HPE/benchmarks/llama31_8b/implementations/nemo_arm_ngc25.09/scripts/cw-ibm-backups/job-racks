#!/bin/bash

THIS_SCRIPT_DIR="$(dirname "$(readlink --canonicalize -- "${BASH_SOURCE[0]}")")"

if [[ "$#" -ne 1 ]]; then
    echo "Usage: $0 jobnum" >&2
    exit 1
fi

join -1 2 -2 1 \
     <("${THIS_SCRIPT_DIR}/racks-and-nodes" | sort -k2,2) \
     <("${THIS_SCRIPT_DIR}/job-nodes" "$1") | cut -f2 -d' ' | sort | uniq -c
