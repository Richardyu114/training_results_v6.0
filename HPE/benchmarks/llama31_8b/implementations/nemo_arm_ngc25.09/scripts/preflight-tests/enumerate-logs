#!/bin/bash

(
    echo -e "file\tgbs\tscore\tconverge\tnodes\tavg-step"
    for arg in "$@"; do
        echo -ne "${arg}"
        echo -ne "\t$(mllog-converge.py ${arg} | cut -f2,3,4,6)"
        echo -ne "\t$(grep MLLOG.*throughput.*train ${arg} | sed -E -e 's/^.*train_step_time": //' -e 's/,.*$//' | sumcol | cut -f3)"
        echo -e  "\t[$(grep -m1 DLPAL ${arg} | sed -E 's/^.*:::DLPAL //' | cut -f3 -d' ')]"
    done
) \
    | column -t
