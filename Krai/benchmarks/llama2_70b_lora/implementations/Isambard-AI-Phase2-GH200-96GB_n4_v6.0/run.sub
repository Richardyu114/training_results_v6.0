#!/bin/bash

set -x

# Vars without defaults
: "${CONT:?CONT not set}"
: "${WALLTIME_RUNANDTIME:?WALLTIME_RUNANDTIME not set}"

# Vars with defaults
: "${DGXNGPUS:=4}"
: "${CPUS_PER_TASK:=36}"
: "${NEXP:=1}"
: "${SEED_BASE:=${SEED-$RANDOM}}"
: "${DATESTAMP:=$(date +'%y%m%d%H%M%S%N')}"
: "${WORK_DIR:=/workspace/ft-llm}"
: "${SLURM_MPI_TYPE:="pmi2"}"
: "${RDZV_BACKEND:="c10d"}"

if [[ "${SLURM_JOB_ID}" ]]; then
    export RUNSUB_DIR=$(dirname $(scontrol show job "${SLURM_JOB_ID}" | awk -F= '/Command=/{print $2}'))
else
    export RUNSUB_DIR=$(dirname "${BASH_SOURCE[0]}")
fi

export MODEL_NAME="llama2_70b_lora"
export MODEL_FRAMEWORK="pytorch"

mkdir -p "${LOGDIR}/${CONFIG_NAME}"
export LOGFILE_BASE="${LOGDIR}/${CONFIG_NAME}/${DATESTAMP}"

export MASTER_ADDR=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -n1)
export MASTER_PORT=29500

export RDZV_ID=my_ft_llm_run_$(date +%s)

export CONT_PATH="/usr/local/lib/python3.12/dist-packages/torch_tensorrt/bin:/usr/local/nvidia/bin:/usr/local/cuda/bin:/usr/local/mpi/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/local/ucx/bin:/opt/amazon/efa/bin:/opt/tensorrt/bin"
export CONT_PYTHONPATH="/workspace/ft-llm/Megatron-LM"
export CONT_TRITON_CACHE_DIR="/triton_cache"

export CACHE_CLEANING_EVENT=':::MLLOG {"namespace": "", "time_ms": 111111111111, "event_type": "POINT_IN_TIME", "key": "cache_clear", "value": true, "metadata": {"file": "<string>", "lineno": 3}}'

export OMP_NUM_THREADS=$((${CPUS_PER_TASK} / ${DGXNGPU}))

for _experiment_index in $(seq 1 "${NEXP}"); do
    printf -v _experiment_index_padded "%02d" "${_experiment_index}"
    printf -v _sbatch_index_padded "%02d" "${NSBATCH}"
    
    echo "EXPERIMENT_START $(date +%s)"
    (
        export SEED=$(($SEED_BASE - 1 + 10#$_experiment_index))
        set +e

        # Record a cache cleaning event. No real cleaning as we do not have sudo.
        set +x
        echo ${CACHE_CLEANING_EVENT}
        set -x

        echo "RUNANDTIME_START $(date +%s)"
        srun -l --mpi="${SLURM_MPI_TYPE:-pmix}" \
		--ntasks-per-node=1 \
                --overlap \
		podman-hpc run --rm \
                        --device nvidia.com/gpu=all \
			--volume "${DATADIR}:/data:ro" \
			--volume "${MODEL}:/ckpt:ro" \
                        --volume "${TRITON_CACHE_DIR}:${CONT_TRITON_CACHE_DIR}:rw" \
                        --volume "./train.py:/workspace/ft-llm/train.py:ro" \
			--network=host \
                        --shm-size=196G \
			--env-host \
                        --env MASTER_ADDR="${MASTER_ADDR}" \
                        --env MASTER_PORT="${MASTER_PORT}" \
                        --env TRITON_CACHE_DIR="${CONT_TRITON_CACHE_DIR}" \
			--env PATH="${CONT_PATH}" \
			--env PYTHONPATH="${CONT_PYTHONPATH}" \
			"${CONT}" \
                        slurm2pytorch torchrun \
                            --nproc_per_node="${DGXNGPU}" \
                            --nnodes="${DGXNNODES}" \
                            --rdzv_backend="${RDZV_BACKEND}" \
                            --rdzv_endpoint="${MASTER_ADDR}:${MASTER_PORT}" \
                            --rdzv_id="${RDZV_ID}" \
                            train.py
        echo "RUNANDTIME_STOP $(date +%s)"
        set -e
    ) |& tee "${LOGFILE_BASE}_batch${_sbatch_index_padded}_run${_experiment_index_padded}.log"
    echo "EXPERIMENT_STOP $(date +%s)"
done

set +x
