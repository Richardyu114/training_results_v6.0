#!/bin/bash

#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:8
#SBATCH --partition=POC-Cluster

set -euxo pipefail

export NCCL_SOCKET_IFNAME=mgmt_eth
export UCX_NET_DEVICES=gpu0_eth,gpu1_eth,gpu2_eth,gpu3_eth,gpu4_eth,gpu5_eth,gpu6_eth,gpu7_eth
export GLOO_SOCKET_IFNAME=mgmt_eth
export NCCL_IB_HCA=gpu0_rdma,gpu1_rdma,gpu2_rdma,gpu3_rdma,gpu4_rdma,gpu5_rdma,gpu6_rdma,gpu7_rdma
export SLURM_MPI_TYPE="${SLURM_MPI_TYPE:-pmix}"

export HSA_NO_SCRATCH_RECLAIM=1
export NCCL_DMABUF_ENABLE=0

: "${PRIMUS_SCRIPT_DIR:=${SLURM_SUBMIT_DIR:-$(pwd)}}"
SCRIPT_DIR=$(readlink -f "${PRIMUS_SCRIPT_DIR}")
cd "${SCRIPT_DIR}"

: "${CONFIG_NAME:=config_MI350X_2x8x1.sh}"
if [[ "${CONFIG_NAME}" = /* ]]; then
  _config_file="${CONFIG_NAME}"
else
  _config_file="${SCRIPT_DIR}/${CONFIG_NAME}"
fi

export PYTHONPATH="${PYTHONPATH:-}"
source "${_config_file}"

: "${CONT:?CONT not set}"
: "${DATADIR:?DATADIR not set}"
: "${MODELDIR:?MODELDIR not set}"
: "${LOGDIR:=${SCRIPT_DIR}/results/${DGXSYSTEM}}"
: "${WORK_DIR:=/workspace/code}"
: "${NEXP:=1}"
: "${CLEAR_CACHES:=1}"
: "${APPLY_RUNTIME_TUNABLES:=0}"
: "${DROPCACHE_CMD:=sudo /sbin/sysctl vm.drop_caches=3}"
: "${DATESTAMP:=$(date +'%y%m%d%H%M%S%N')}"
: "${SEED_BASE:=${SEED:-$RANDOM}}"
: "${CONT_NAME:=mlperf_primus_llama31_8b}"
: "${WALLTIME_RUNANDTIME:=05:00:00}"
: "${CPUS_PER_TASK:=128}"

export CONFIG_NAME="$(basename "${_config_file}")"
export DATADIR MODELDIR LOGDIR CONT WORK_DIR NEXP CLEAR_CACHES DATESTAMP CONT_NAME
export MASTER_ADDR="$(scontrol show hostnames "${SLURM_JOB_NODELIST}" | head -n1)"
export MASTER_PORT

echo "using MASTER_ADDR \"${MASTER_ADDR}\" of list \"${SLURM_JOB_NODELIST}\""
echo "using container image ${CONT}"
echo "using data directory ${DATADIR}"
echo "using model directory ${MODELDIR}"
echo "using log directory ${LOGDIR}"

mkdir -p "${LOGDIR}" "${LOGDIR}/artifacts"

_data_mounts="${DATADIR}:/data,${MODELDIR}:/model,${SCRIPT_DIR}:/workspace/code,${LOGDIR}:/results"
_rdma_mounts="/usr/lib/x86_64-linux-gnu/libibverbs.so.1:/host-rdma/lib/libibverbs.so.1:ro,/usr/lib/x86_64-linux-gnu/librdmacm.so.1:/host-rdma/lib/librdmacm.so.1:ro,/usr/lib/x86_64-linux-gnu/libibverbs:/host-rdma/lib/libibverbs:ro,/lib/x86_64-linux-gnu/libnl-3.so.200:/host-rdma/lib/libnl-3.so.200:ro,/lib/x86_64-linux-gnu/libnl-route-3.so.200:/host-rdma/lib/libnl-route-3.so.200:ro,/usr/lib/x86_64-linux-gnu/libionic.so.1.0.54.0-149.g3304be71:/host-rdma/lib/libionic.so.1.0.54.0-149.g3304be71:ro,/etc/libibverbs.d:/etc/libibverbs.d:ro"
_cont_mounts="${_data_mounts},${_rdma_mounts}"

export LD_LIBRARY_PATH="/host-rdma/lib:/host-rdma/lib/libibverbs:${LD_LIBRARY_PATH:-}"
export RDMAV_PROVIDERS_PATH="/host-rdma/lib/libibverbs"

if [[ "${APPLY_RUNTIME_TUNABLES}" -eq 1 ]]; then
  srun -N "${NNODES}" --ntasks-per-node=1 --mpi="${SLURM_MPI_TYPE}" \
    bash -lc "cd '${SCRIPT_DIR}' && bash runtime_tunables.sh"
fi

mapfile -t _config_env < <(env -i bash -c ". '${_config_file}' && compgen -e" | grep -E -v '^(PWD|SHLVL)$')
_extra_env=(
  AITER_CONFIG_GEMM_A4W4
  CONFIG_NAME
  CONT
  DATA_PATH
  DATADIR
  DGXSYSTEM
  GLOO_SOCKET_IFNAME
  GPUS_PER_NODE
  HSA_NO_SCRATCH_RECLAIM
  LD_LIBRARY_PATH
  LOGDIR
  MASTER_ADDR
  MASTER_PORT
  MODELDIR
  NCCL_DEBUG
  NCCL_DEBUG_SUBSYS
  NCCL_DMABUF_ENABLE
  NCCL_IB_HCA
  NCCL_SOCKET_IFNAME
  NNODES
  NODE_RANK
  OMPI_MCA_btl
  OMPI_MCA_btl_base_warn_component_unused
  OMPI_MCA_btl_tcp_if_include
  OMPI_MCA_pml
  RDMAV_PROVIDERS_PATH
  SEED
  SLURM_NODEID
  UCX_NET_DEVICES
)

declare -A _seen_env=()
declare -a _env_names=()
for _env_name in "${_config_env[@]}" "${_extra_env[@]}"; do
  if [[ -n "${_env_name}" && -z "${_seen_env[${_env_name}]:-}" ]]; then
    _seen_env["${_env_name}"]=1
    _env_names+=("${_env_name}")
  fi
done

_container_env=$(IFS=,; echo "${_env_names[*]}")

for _experiment_index in $(seq 1 "${NEXP}"); do
  _current_log_file="${LOGDIR}/${DATESTAMP}_${_experiment_index}.log"

  if [[ "${CLEAR_CACHES}" -eq 1 ]]; then
    srun -N "${NNODES}" --ntasks-per-node=1 --mpi="${SLURM_MPI_TYPE}" \
      bash -lc "echo -n 'Clearing cache on ' && hostname && sync && ${DROPCACHE_CMD}"
  fi

  export SEED=$((SEED_BASE - 1 + 10#${_experiment_index}))
  echo "Beginning trial ${_experiment_index} of ${NEXP} with SEED=${SEED}"
  echo "RUNANDTIME_START $(date +%s)"

  srun -l --mpi="${SLURM_MPI_TYPE}" \
    -N "${NNODES}" \
    --ntasks-per-node=1 \
    --gres="gpu:${GPUS_PER_NODE}" \
    --cpus-per-task="${CPUS_PER_TASK}" \
    --time="${WALLTIME_RUNANDTIME}" \
    --container-image="${CONT}" \
    --container-writable \
    --container-mounts="${_cont_mounts}" \
    --container-workdir="${WORK_DIR}" \
    --container-env="${_container_env}" \
    bash -lc 'export NODE_RANK="${SLURM_NODEID}"; export DATA_PATH=/data; bash /workspace/code/run_and_time.sh' \
    2>&1 | tee "${_current_log_file}"

  echo "RUNANDTIME_STOP $(date +%s)"
done
