# SBATCH entry point for MLPerf GPT-OSS-20B (MoE) Primus training using the
# Pyxis/Enroot container runtime on Slurm. One srun task per node; pyxis
# launches the container image (.sqsh) on every node with the configured
# bind mounts (data, model, code, results, /dev/{dri,kfd,infiniband}) and
# the environment variables exported by the sourced config.
#
# Required environment variables (set in the calling shell or via sbatch --export):
#   CONT       Path to the container image (.sqsh squashfs or `dockerd://...`)
#   DATADIR    Pre-tokenized dataset directory (mounted at /data inside container)
#   MODELDIR   Tokenizer / model directory   (mounted at /model inside container)
#
# Required either via env or via the sbatch shell:
#   DGXSYSTEM  Selects config_${DGXSYSTEM}.sh (e.g. MI350X_2x8x1_tp1pp1ep1_gbs64)
#     OR
#   CONFIG_NAME  Explicit config script filename (or absolute path) to source
#
# Common optional variables:
#   LOGDIR                 Defaults to ${PRIMUS_SCRIPT_DIR}/results/${DGXSYSTEM}
#   NEXP                   Number of experiment repetitions (default 1)
#   CLEAR_CACHES           1 to drop OS caches before each trial (default 1)
#   APPLY_RUNTIME_TUNABLES 1 to run runtime_tunables.sh on each node first (default 0)
#   CHECK_RDMA             1 to enumerate RDMA HCAs (ibv_devices) inside the
#                          container before the first trial (default 1; set 0
#                          to skip)
#   CHECK_COMPLIANCE       1 to run mlperf_logging.compliance_checker per trial (default 0)
#   ABORT_ON_FAIL          1 to fail-fast (abort the NEXP loop on first trial
#                          failure); default 0 — single-trial failures are
#                          logged and the loop continues to the next trial
#   MOUNT_HOST_LIBIONIC    1 to bind-mount vendor/host-rdma/libionic.so... over
#                          the container's identically-named file (default 1).
#                          The host build is what kernel/firmware were paired
#                          with; container ships a different binary with the
#                          same version string. Set 0 to use container's own.
#   MLPERF_RULESET         Compliance ruleset version (default 6.0.0)
#   SEED / SEED_BASE       Random seed control (default $RANDOM, monotonic per trial)
#   WALLTIME_RUNANDTIME    Per-srun --time= for the training step (default 05:00:00)
#   CPUS_PER_TASK          Cores per Slurm task (default 128)
#   MASTER_PORT            torch.distributed master port (default 29501)
#   CONT_NAME              Logical container name (default mlperf_primus_gpt_oss_20b)

#SBATCH --exclusive
#SBATCH --mem=0
#SBATCH --ntasks-per-node=1
#SBATCH --gres=gpu:8

set -euo pipefail

# -----------------------------------------------------------------------------
# Networking defaults. Default the rendezvous interface to whatever is on the
# host's default route (matches run_with_docker_slurm.sh). The per-GPU RDMA
# HCAs and UCX devices are typically pinned in the config file; set safe
# defaults here only as a last-resort fallback.
# -----------------------------------------------------------------------------
export NCCL_SOCKET_IFNAME=
export UCX_NET_DEVICES=
export GLOO_SOCKET_IFNAME=
export NCCL_IB_HCA=
export SLURM_MPI_TYPE="${SLURM_MPI_TYPE:-pmix}"

# -----------------------------------------------------------------------------
# Resolve script directory. Prefer the explicit env (set by the wrapper
# launcher) so cwd inside this batch script doesn't matter. Fall back to
# ${SLURM_SUBMIT_DIR} when sbatched without a wrapper.
# -----------------------------------------------------------------------------
: "${PRIMUS_SCRIPT_DIR:=${SLURM_SUBMIT_DIR:-$(pwd)}}"
SCRIPT_DIR=$(readlink -f "${PRIMUS_SCRIPT_DIR}")
cd "${SCRIPT_DIR}"

# -----------------------------------------------------------------------------
# Resolve config file. Allow explicit CONFIG_NAME override; otherwise derive
# from DGXSYSTEM (existing convention used by run_with_docker*.sh).
# -----------------------------------------------------------------------------
if [[ -n "${CONFIG_NAME:-}" ]]; then
    if [[ "${CONFIG_NAME}" = /* ]]; then
        _config_file="${CONFIG_NAME}"
    else
        _config_file="${SCRIPT_DIR}/${CONFIG_NAME}"
    fi
elif [[ -n "${DGXSYSTEM:-}" ]]; then
    _config_file="${SCRIPT_DIR}/config_${DGXSYSTEM}.sh"
else
    echo "ERROR: set either DGXSYSTEM (e.g. MI350X_2x8x1_tp1pp1ep1_gbs64)"   >&2
    echo "       or CONFIG_NAME (path/filename of the config script to source)" >&2
    exit 1
fi

if [[ ! -f "${_config_file}" ]]; then
    echo "ERROR: config file ${_config_file} not found" >&2
    exit 1
fi

export PYTHONPATH="${PYTHONPATH:-}"
# shellcheck disable=SC1090
source "${_config_file}"

# -----------------------------------------------------------------------------
# Required and optional inputs.
# -----------------------------------------------------------------------------
: "${CONT:?CONT not set (path to .sqsh image or dockerd://... reference)}"
: "${DATADIR:?DATADIR not set}"
: "${MODELDIR:?MODELDIR not set}"
: "${DGXSYSTEM:?DGXSYSTEM not set in config}"
: "${NNODES:?NNODES not set in config}"
: "${GPUS_PER_NODE:?GPUS_PER_NODE not set in config}"

: "${LOGDIR:=${SCRIPT_DIR}/results/${DGXSYSTEM}}"
: "${WORK_DIR:=/workspace/code}"
: "${NEXP:=1}"
: "${CLEAR_CACHES:=1}"
: "${APPLY_RUNTIME_TUNABLES:=0}"
: "${CHECK_RDMA:=1}"
: "${CHECK_COMPLIANCE:=0}"
# When 0 (default), a single trial failure does NOT abort the NEXP loop;
# remaining trials still run, and the script reports the per-trial outcome
# at the end. Set to 1 to restore the old fail-fast behaviour.
: "${ABORT_ON_FAIL:=0}"
# When 1 (default), bind-mount the host's libionic provider over the
# container's identically-named file. Host and container both ship
# libionic.so.1.0.54.0-149.g3304be71 (same version string) but the binaries
# differ; the host build is the version the kernel ionic_rdma driver and NIC
# firmware were co-engineered against. Set to 0 to fall back to the
# container's own libionic.
: "${MOUNT_HOST_LIBIONIC:=1}"
: "${MLPERF_RULESET:=6.0.0}"
: "${DROPCACHE_CMD:=sudo /sbin/sysctl vm.drop_caches=3}"
: "${DATESTAMP:=$(date +'%y%m%d%H%M%S%N')}"
: "${SEED_BASE:=${SEED:-$RANDOM}}"
: "${CONT_NAME:=mlperf_primus_gpt_oss_20b}"
: "${WALLTIME_RUNANDTIME:=05:00:00}"
: "${CPUS_PER_TASK:=128}"
: "${MASTER_PORT:=29501}"
: "${HF_TOKEN:=}"

# -----------------------------------------------------------------------------
# Logging / runtime knobs. All env-overridable.
#   MLPERF_VERBOSE_LOGS    1 keeps loguru per-rank file sinks live (default 0).
#   PYTHONFAULTHANDLER     1 installs a Python faulthandler so native crashes
#                          (SIGSEGV/SIGABRT in C/C++ extensions) still emit a
#                          Python stack frame.
#   PYTHONUNBUFFERED       1 forces unbuffered stdout/stderr so MLLOG events
#                          (stdlib logging.StreamHandler(sys.stdout)) flush
#                          per-line under srun -> tee.
#   PRIMUS_WORKSPACE       Loguru/primus workspace dir (host-visible under
#                          ${LOGDIR} via bind mount).
#   LOCAL_RANKS            torchrun flags for per-rank stdout/stderr capture.
# -----------------------------------------------------------------------------
: "${MLPERF_VERBOSE_LOGS:=0}"
: "${PYTHONFAULTHANDLER:=1}"
: "${PYTHONUNBUFFERED:=1}"
: "${PRIMUS_WORKSPACE:=/results/primus_output}"
: "${PRIMUS_TORCHELASTIC_LOG_DIR:=/results/torchelastic_logs}"
: "${PRIMUS_SHOW_ALL_RANKS:=0}"
: "${LOCAL_RANKS:=--redirects 3 --tee 3 --log-dir ${PRIMUS_TORCHELASTIC_LOG_DIR}}"
export MLPERF_VERBOSE_LOGS PYTHONFAULTHANDLER PYTHONUNBUFFERED \
       PRIMUS_WORKSPACE PRIMUS_TORCHELASTIC_LOG_DIR \
       PRIMUS_SHOW_ALL_RANKS LOCAL_RANKS

export CONFIG_NAME="$(basename "${_config_file}")"
export DATADIR MODELDIR LOGDIR CONT WORK_DIR NEXP CLEAR_CACHES DATESTAMP CONT_NAME

# Resolve master from the Slurm job's node list. Single-node sanity-defaults.
if [[ -n "${SLURM_JOB_NODELIST:-}" ]]; then
    MASTER_ADDR="$(scontrol show hostnames "${SLURM_JOB_NODELIST}" | head -n1)"
else
    MASTER_ADDR="${MASTER_ADDR:-localhost}"
fi
export MASTER_ADDR MASTER_PORT

echo "using MASTER_ADDR \"${MASTER_ADDR}\" of list \"${SLURM_JOB_NODELIST:-${MASTER_ADDR}}\""
echo "using config       ${_config_file}"
echo "using container    ${CONT}"
echo "using DATADIR      ${DATADIR}"
echo "using MODELDIR     ${MODELDIR}"
echo "using LOGDIR       ${LOGDIR}"
echo "using NCCL/GLOO IF ${NCCL_SOCKET_IFNAME:-<unset>} / ${GLOO_SOCKET_IFNAME:-<unset>}"

mkdir -p "${LOGDIR}" "${LOGDIR}/artifacts"
# Pre-create the host directories that PRIMUS_WORKSPACE and
# PRIMUS_TORCHELASTIC_LOG_DIR will resolve to inside the container. The
# container path /results == ${LOGDIR} on the host, so primus_output and
# torchelastic_logs land directly under ${LOGDIR}/.
mkdir -p "${LOGDIR}/primus_output" "${LOGDIR}/torchelastic_logs"

# -----------------------------------------------------------------------------
# Container bind mounts:
#   - Dataset, model, code, results
#   - Optional ../../utilities (compliance-checker / shared helpers)
#   - GPU + RDMA device passthrough so ROCm and the Pensando/AINIC stack work
#     inside the container, mirroring `docker run --device …` from
#     run_with_docker_slurm.sh.
# -----------------------------------------------------------------------------
_data_mounts="${DATADIR}:/data,${MODELDIR}:/model,${SCRIPT_DIR}:/workspace/code,${LOGDIR}:/results"

if [[ -d "${SCRIPT_DIR}/../../utilities" ]]; then
    _utilities_path="$(readlink -f "${SCRIPT_DIR}/../../utilities")"
    _data_mounts="${_data_mounts},${_utilities_path}:/workspace/utilities"
fi

_device_mounts=""
_append_dev_mount() {
    local entry="$1"
    if [[ -z "${_device_mounts}" ]]; then
        _device_mounts="${entry}"
    else
        _device_mounts="${_device_mounts},${entry}"
    fi
}

# Bind mount the device trees we need. Each entry is silently skipped if the
# source path is missing on the host (e.g. a node with no AINIC / no IB).
for _dev in /dev/dri /dev/kfd /dev/infiniband; do
    if [[ -e "${_dev}" ]]; then
        _append_dev_mount "${_dev}:${_dev}"
    fi
done

if [[ -n "${_device_mounts}" ]]; then
    _cont_mounts="${_data_mounts},${_device_mounts}"
else
    echo "WARNING: no /dev/{dri,kfd,infiniband} found on host; container will have no GPUs/RDMA"
    _cont_mounts="${_data_mounts}"
fi

# -----------------------------------------------------------------------------
# Optionally bind-mount the host's libionic over the container's same-named
# file (see MOUNT_HOST_LIBIONIC docstring above). Bind mount targets the
# canonical path inside the container, so libibverbs/<provider>.so symlinks
# resolve transparently. Skipped silently if the source file is missing.
# -----------------------------------------------------------------------------
if [[ "${MOUNT_HOST_LIBIONIC}" -eq 1 ]]; then
    _libionic_basename="libionic.so.1.0.54.0-149.g3304be71"
    _host_libionic_src="${SCRIPT_DIR}/vendor/host-rdma/${_libionic_basename}"
    _host_libionic_dst="/usr/lib/x86_64-linux-gnu/${_libionic_basename}"
    if [[ -f "${_host_libionic_src}" ]]; then
        _cont_mounts="${_cont_mounts},${_host_libionic_src}:${_host_libionic_dst}:ro"
        echo "MOUNT_HOST_LIBIONIC=1: overriding container libionic with $(sha256sum "${_host_libionic_src}" | awk '{print substr($1,1,12)}') from ${_host_libionic_src}"
    else
        echo "MOUNT_HOST_LIBIONIC=1 but ${_host_libionic_src} not found; falling back to container's own libionic"
    fi
fi

# -----------------------------------------------------------------------------
# Optionally apply OS-level performance tunables on every node before training.
# -----------------------------------------------------------------------------
if [[ "${APPLY_RUNTIME_TUNABLES}" -eq 1 ]]; then
    srun -N "${NNODES}" --ntasks-per-node=1 --mpi="${SLURM_MPI_TYPE}" \
        bash -lc "cd '${SCRIPT_DIR}' && bash runtime_tunables.sh"
fi

# -----------------------------------------------------------------------------
# Build the env-var list to forward into each container. We start with every
# variable defined by the sourced config (so any new PRIMUS_* / NVTE_* / NCCL_*
# knob is picked up automatically) and then add the runtime-supplied vars.
# -----------------------------------------------------------------------------
mapfile -t _config_env < <(env -i bash -c ". '${_config_file}' && compgen -e" | grep -E -v '^(PWD|SHLVL)$')

_extra_env=(
    CONFIG_NAME
    CONT
    DATA_PATH
    DATADIR
    DGXSYSTEM
    GLOO_SOCKET_IFNAME
    GPUS_PER_NODE
    HF_TOKEN
    HSA_NO_SCRATCH_RECLAIM
    LOCAL_RANKS
    LOGDIR
    MASTER_ADDR
    MASTER_PORT
    MLPERF_VERBOSE_LOGS
    MODELDIR
    NCCL_DEBUG
    NCCL_DEBUG_SUBSYS
    NCCL_DMABUF_ENABLE
    NCCL_IB_HCA
    NCCL_SOCKET_IFNAME
    NNODES
    NODE_RANK
    PRIMUS_SHOW_ALL_RANKS
    PRIMUS_TORCHELASTIC_LOG_DIR
    PRIMUS_WORKSPACE
    PYTHONFAULTHANDLER
    PYTHONUNBUFFERED
    SEED
    SLURM_JOB_NODELIST
    SLURM_NNODES
    SLURM_NODEID
    SLURM_PROCID
    UCX_NET_DEVICES
)

declare -A _seen_env=()
declare -a _env_names=()
for _env_name in "${_config_env[@]}" "${_extra_env[@]}"; do
    if [[ -n "${_env_name}" && -z "${_seen_env[${_env_name}]:-}" ]]; then
        _seen_env["${_env_name}"]=1
        _env_names+=("${_env_name}")
    fi
done

_container_env=$(IFS=,; echo "${_env_names[*]}")

# -----------------------------------------------------------------------------
# Run experiments.
#
# The trial body must NOT abort the NEXP loop on a single failure: a transient
# device fault would otherwise turn an NEXP=10 submission into NEXP="until
# first failure". We therefore run each trial with `set +e` around the srun
# pipeline, capture srun's exit code via ${PIPESTATUS[0]} (the `| tee` would
# otherwise mask it), and aggregate per-trial outcomes for an end-of-run
# summary.
#
# Set ABORT_ON_FAIL=1 to restore the fail-fast behaviour.
# -----------------------------------------------------------------------------
declare -i _trials_passed=0
declare -i _trials_failed=0
declare -a _failed_trial_ids=()

for _experiment_index in $(seq 1 "${NEXP}"); do
    _current_log_file="${LOGDIR}/${DATESTAMP}_${_experiment_index}.log"

    if [[ "${CLEAR_CACHES}" -eq 1 ]]; then
        srun -N "${NNODES}" --ntasks-per-node=1 --mpi="${SLURM_MPI_TYPE}" \
            bash -lc "echo -n 'Clearing cache on ' && hostname && sync && ${DROPCACHE_CMD}"
    fi

    export SEED=$((SEED_BASE - 1 + 10#${_experiment_index}))
    echo "Beginning trial ${_experiment_index} of ${NEXP} with SEED=${SEED}"
    echo "RUNANDTIME_START $(date +%s)"

    # Disable errexit just for the trial pipeline so a non-zero srun exit does
    # not kill the whole script via `set -e`. PIPESTATUS preserves srun's exit
    # code through the `| tee` (which would otherwise always be 0).
    set +e
    srun -l --mpi="${SLURM_MPI_TYPE}" \
        -N "${NNODES}" \
        --ntasks-per-node=1 \
        --gres="gpu:${GPUS_PER_NODE}" \
        --cpus-per-task="${CPUS_PER_TASK}" \
        --time="${WALLTIME_RUNANDTIME}" \
        --container-image="${CONT}" \
        --container-name="${CONT_NAME}" \
        --container-writable \
        --container-mounts="${_cont_mounts}" \
        --container-workdir="${WORK_DIR}" \
        --container-env="${_container_env}" \
        bash -lc 'export NODE_RANK="${SLURM_NODEID:-0}"; export DATA_PATH="${DATA_PATH:-/data}"; bash /workspace/code/run_and_time.sh' \
        2>&1 | tee "${_current_log_file}"
    _trial_rc=${PIPESTATUS[0]}
    set -e

    echo "RUNANDTIME_STOP $(date +%s)"

    if [[ "${_trial_rc}" -eq 0 ]]; then
        _trials_passed=$((_trials_passed + 1))
        echo "Trial ${_experiment_index} of ${NEXP} PASSED (srun rc=0)"
    else
        _trials_failed=$((_trials_failed + 1))
        _failed_trial_ids+=("${_experiment_index}")
        echo "Trial ${_experiment_index} of ${NEXP} FAILED (srun rc=${_trial_rc})"
    fi

    if [[ "${_trial_rc}" -ne 0 ]]; then
        if [[ "${ABORT_ON_FAIL}" -eq 1 ]]; then
            echo "ABORT_ON_FAIL=1 set; aborting NEXP loop after first failure"
            break
        fi
        echo "Continuing to next trial (set ABORT_ON_FAIL=1 to fail-fast instead)"
    fi

    # Optional MLPerf compliance check: re-enter the container on rank 0 only
    # (the same pyxis container is reused via --container-name). Only meaningful
    # if the trial actually produced a complete log.
    if [[ "${CHECK_COMPLIANCE}" -eq 1 && "${_trial_rc}" -eq 0 ]]; then
        srun --overlap -l --mpi="${SLURM_MPI_TYPE}" \
            -N1 --ntasks-per-node=1 \
            --container-name="${CONT_NAME}" \
            --container-mounts="${_cont_mounts}" \
            --container-workdir="${WORK_DIR}" \
            python3 -m mlperf_logging.compliance_checker \
                --usage training \
                --ruleset "${MLPERF_RULESET}" \
                --log_output "/results/compliance_${DATESTAMP}_${_experiment_index}.out" \
                "/results/${DATESTAMP}_${_experiment_index}.log" \
            || echo "WARNING: Compliance check failed for experiment ${_experiment_index} (non-blocking)"
    fi
done