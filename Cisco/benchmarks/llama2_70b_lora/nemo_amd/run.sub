#SBATCH --exclusive
#SBATCH --mem=0

set -euxo pipefail

if [[ -n "${SLURM_JOB_ID:-}" && -z "${CODE_DIR:-}" ]]; then
  echo "run.sub: CODE_DIR is unset. Submit via run_2node.sh (sources run_env.sh) or export CODE_DIR to this repo's code/ path." >&2
  exit 1
fi
if [[ -n "${CODE_DIR:-}" ]]; then
  SCRIPT_DIR="${CODE_DIR}"
else
  SCRIPT_DIR=$(dirname "$(readlink -f "$0")")
fi
cd "$SCRIPT_DIR"

# Values that depend on the batch job / compute node (not the submit host)
export CONT_NAME="${CONT_NAME:-mlperf_llama2sft_${SLURM_JOB_ID}}"
export DATESTAMP="${DATESTAMP:-$(date +'%y%m%d%H%M%S%N')}"
export SPREFIX="${DGXNNODES}x${DGXNGPU}x${MINIBS}_${DATESTAMP}"

export MASTER_ADDR="$(scontrol show hostnames "${SLURM_JOB_NODELIST-}" | head -n1)"
echo "using MASTER_ADDR \"${MASTER_ADDR}\" of list \"${SLURM_JOB_NODELIST}\""

PYXIS_DEFAULTS=( '--no-container-mount-home' '--container-remap-root' '--container-writable' )
readonly _cont_name="${CONT_NAME}"

_rdma_mounts="/sys/class/infiniband:/sys/class/infiniband:ro,/sys/class/infiniband_verbs:/sys/class/infiniband_verbs:ro,/dev/infiniband:/dev/infiniband"

_cont_mounts=("${DATADIR}/data:/data,${MODELDIR}:/ckpt,${MLPERF_MODELS_ROOT}:${MLPERF_MODELS_ROOT}:ro,${SCRIPT_DIR}:/workspace/code/,${LOGDIR}:/results,${_rdma_mounts}")

# Setup directories
mkdir -p "${LOGDIR}"

# Include mounts when creating container so they're available from the start
srun --ntasks-per-node=1 --container-image="${CONT}" --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" \
    --container-mounts="${_cont_mounts}" true

for _experiment_index in $(seq 0 $((NEXP-1))); do
{
  _current_log_file="${LOGDIR}/result_${_experiment_index}.txt"
  srun -N1 -n1 --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" bash -c 'echo ":::GITCOMMITID ${GIT_COMMIT_ID} ${LAUNCHER_GIT_COMMIT_ID}"'

  if [ "${CLEAR_CACHES}" -eq 1 ]; then
      srun --ntasks-per-node=1 bash -c "echo -n 'Clearing cache on ' && hostname && sync && ${DROPCACHE_CMD}"
  fi

  # Run experiment: distinct SEED per NEXP index; NeMo requires seed >= 1 (avoid empty SEED_BASE -> -1).
  if [[ -z "${SEED_BASE}" ]] || ! [[ "${SEED_BASE}" =~ ^[0-9]+$ ]] || [[ "${SEED_BASE}" -lt 2 ]]; then
    export SEED_BASE=$((RANDOM + RANDOM + 2))
  fi
  export SEED=$(($SEED_BASE - 1 + 10#$_experiment_index))
  echo "launching experiment: ${_cont_name} bash ./run_and_time.sh"
  set +e
  echo "RUNANDTIME_START $(date +%s)"
  srun -l --mpi="${SLURM_MPI_TYPE:-pmi2}" \
    -N "${DGXNNODES}" \
    --ntasks-per-node=${DGXNGPU} \
     --gres=gpu:${DGXNGPU} \
    --time="${WALLTIME_RUNANDTIME}" \
    --container-name="${_cont_name}" "${PYXIS_DEFAULTS[@]}" \
    --container-mounts="${_cont_mounts}" \
    --container-workdir="${WORK_DIR}" \
    --container-env=MASTER_PORT \
    --container-env=MASTER_ADDR \
    --container-env=DGXSYSTEM \
    --container-env=SLURM_PROCID \
    --container-env=SLURM_LOCALID \
    --container-env=SLURM_NTASKS \
    --container-env=SLURM_NODEID \
    --container-env=SLURM_JOB_NODELIST \
    --container-env=SLURM_NNODES \
    --container-env=NCCL_DEBUG \
    --container-env=NCCL_DEBUG_SUBSYS \
    --container-env=NCCL_IB_DISABLE \
    --container-env=NCCL_IB_HCA \
    --container-env=NCCL_IB_GID_INDEX \
    --container-env=NCCL_IB_TIMEOUT \
    --container-env=NCCL_IB_RETRY_CNT \
    --container-env=NCCL_SOCKET_IFNAME \
    --container-env=GLOO_SOCKET_IFNAME \
    --container-env=UCX_NET_DEVICES \
    --container-env=UCX_TLS \
    --container-env=PYTHONUNBUFFERED \
    --container-env=SEED \
    --container-env=RCCL_MSCCL_ENABLE \
    --container-env=HSA_FORCE_FINE_GRAIN_PCIE \
    ./run_and_time.sh
  echo "RUNANDTIME_STOP $(date +%s)"
} 
done
