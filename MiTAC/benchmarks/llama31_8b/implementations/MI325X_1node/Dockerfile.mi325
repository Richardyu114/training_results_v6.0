FROM rocm/pytorch:rocm6.4_ubuntu22.04_py3.10_pytorch_release_2.6.0

WORKDIR /workspace

RUN pip install pybind11
RUN pip install ninja
RUN pip install packaging
RUN /usr/bin/python3 -m pip install pyYAML

# Install library dependencies
WORKDIR /workspace/deps

# FlashAttention (initial build against base torch; ABI-rebuilt below after the torch reinstall)
RUN git clone https://github.com/ROCm/flash-attention/ flash_attention \
    # latest stable commit of ck_tile/fa3 branch
    && cd flash_attention && git checkout cace3592812640486b04196a209bb85d12267b4c \
    && git submodule update --init --recursive \
    && PYTORCH_ROCM_ARCH='gfx942' GPU_ARCHS="gfx942" MAX_JOBS=64 pip install --no-build-isolation -e .

ADD patches /workspace/deps/patches

# Megatron-core
RUN git clone --recursive https://github.com/ROCm/Megatron-LM.git megatron_lm
RUN pip uninstall -y megatron-core
# dev branch commit
RUN cd megatron_lm && git checkout megatron_190213a_mlperf   \
    && pip install -e . && cd megatron/core/datasets && make

ENV PYTHONPATH "${PYTHONPATH}:/workspace/deps/megatron_lm"

# mamba-ssm (initial build against base torch; satisfies NeMo's `mamba-ssm==2.2.2`
# pip-resolver requirement so NeMo install doesn't try to fetch the broken PyPI
# sdist. ABI-rebuilt below after the torch reinstall.)
RUN git clone https://github.com/state-spaces/mamba.git mamba_ssm \
    && cd mamba_ssm \
    && git checkout v2.2.2 \
    && export HIP_ARCHITECTURES="gfx942" \
    && pip install --no-cache-dir --verbose .

# NeMo
RUN git clone https://github.com/NVIDIA/NeMo nemo \
    && cd nemo && git checkout v2.1.0
RUN cd /workspace/deps/nemo \
    && git apply /workspace/deps/patches/nemo_v2_1_0.patch \
    && pip install --no-build-isolation -e ".[nlp]"

# NeMo-Run
RUN pip install git+https://github.com/NVIDIA/NeMo-Run.git@v0.4.0

# Python deps
# Important this should be done after NeMo, otherwise the pinned transformers==4.40.2 version will be overwritten
COPY requirements.txt requirements.txt
RUN pip3 install -r requirements.txt

# NeMo's transitive deps (lightning/pytorch-lightning) pull a vanilla CUDA torch
# wheel from PyPI which uninstalls the base image's ROCm torch. Restore both
# torch and torchvision from the rocm6.4 index so (a) IS_HIP_EXTENSION is True
# for the TE build below, and (b) torchvision's ABI matches the new torch.
#
# Pin torch==2.8.0 specifically: torch 2.9 removed several private torch.onnx
# internals that TE 1.9 imports eagerly (`_type_utils`, `_internal.jit_utils`),
# breaking `import transformer_engine.pytorch`. torch 2.8 still has them.
# torch 2.7 is not published on the rocm6.4 index.
RUN pip install --force-reinstall --no-deps torch==2.8.0 torchvision==0.23.0 \
    --index-url https://download.pytorch.org/whl/rocm6.4

# Pin triton to 3.3.1 — torch 2.8's inductor backend imports `triton_key` from
# triton.compiler.compiler, which exists in triton 3.3.x but was removed in
# 3.5+. NeMo's deps install triton 3.6 by default; force the matching version.
RUN pip install --force-reinstall --no-deps triton==3.3.1

# Rebuild flash-attention and mamba-ssm against the new torch ABI.
# The earlier builds linked torch 2.6's c10 symbols; after the torch reinstall
# above swaps in 2.9.1+rocm6.4 those symbols are gone (e.g. flash_attn_2_cuda
# `_ZNK3c106SymInt6sym_neERKS0_`), so any import would fail at runtime.
# `--force-reinstall --no-deps` re-runs setup.py build_ext against the new torch.
RUN cd /workspace/deps/flash_attention \
    && PYTORCH_ROCM_ARCH='gfx942' GPU_ARCHS="gfx942" MAX_JOBS=64 \
       pip install --force-reinstall --no-deps --no-build-isolation -e .
RUN cd /workspace/deps/mamba_ssm \
    && HIP_ARCHITECTURES="gfx942" \
       pip install --force-reinstall --no-deps --no-cache-dir .

# Transformer Engine
ARG TE_COMMIT=te_v1.9_mlperf_llama2
RUN git clone --recursive https://github.com/ROCm/TransformerEngine.git \
    # dev branch commit
    && cd TransformerEngine && git checkout $TE_COMMIT && git submodule update --init --recursive \
    # Workaround logging debug info to the console
    && sed -i 's/self.logger.info/self.logger.debug/g' /workspace/deps/TransformerEngine/transformer_engine/pytorch/attention.py \
    && sed -i 's/warnings.warn/if False: warnings.warn/g' /workspace/deps/TransformerEngine/transformer_engine/pytorch/attention.py \
    && sed -i '/.*\"window_size should be.*/d' /workspace/deps/TransformerEngine/transformer_engine/common/fused_attn_rocm/fused_attn.cpp \
    && NVTE_USE_ROCM=1 NVTE_FUSED_ATTN_AOTRITON=0 NVTE_ROCM_ARCH='gfx942' NVTE_FRAMEWORK='pytorch' NVTE_USE_HIPBLASLT=1 MAX_JOBS=128 PYTORCH_ROCM_ARCH='gfx942' GPU_ARCHS='gfx942' pip install  -e .

WORKDIR /workspace/code

# Copy the current state of the code inside the image
COPY . .
